# Munaxa Control — API configuration. Every value here is validated at startup; a missing or
# malformed one stops the process rather than surfacing at the first request.

NODE_ENV=development
PORT=3100
LOG_LEVEL=info

# The runtime role (control_app). Never the schema owner.
DATABASE_URL=postgresql://control_app:<password>@localhost:5432/control
# The schema owner, for `pnpm db:migrate` only. Never given to the running service.
DATABASE_MIGRATION_URL=postgresql://control_owner:<password>@localhost:5432/control

# Munaxa Identity. The issuer must equal Identity's IDENTITY_BASE_URL character for character, and
# Identity's IDENTITY_AUTH_AUDIENCE must include the audience below.
OPERATOR_AUTH_ISSUER=https://control.munaxa.example/api/auth
OPERATOR_AUTH_AUDIENCE=munaxa-control
OPERATOR_AUTH_ALGORITHM=ES256
# Identity's PUBLIC key(s), JSON [{"kid","publicKey"}]. A private key here is refused.
OPERATOR_AUTH_PUBLIC_KEYS=[{"kid":"<identity kid>","publicKey":"-----BEGIN PUBLIC KEY-----\n…\n-----END PUBLIC KEY-----"}]
# The Identity organisation Munaxa Group staff sign in to. Tokens from any other are refused.
OPERATOR_ORGANISATION_ID=<identity organisation id>
# Turn on as soon as Munaxa Identity ships MFA (its ADR-0003).
OPERATOR_REQUIRE_MFA=false

# Licence signing. The private key is a mounted file — never an environment value, never an image layer.
LICENCE_SIGNING_PRIVATE_KEY_FILE=/run/secrets/licence_signing_private_key.pem
LICENCE_SIGNING_KID=licence-2026-11
LICENCE_SIGNING_ALGORITHM=ES256
# Earlier public keys installations still trust, during a rotation. Public keys only.
LICENCE_PREVIOUS_PUBLIC_KEYS=[]
LICENCE_MAX_TERM_DAYS=400

ENTITLEMENT_CACHE_SECONDS=30
IDEMPOTENCY_RETENTION_HOURS=48
